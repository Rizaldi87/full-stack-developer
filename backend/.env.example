# PostgreSQL connection string (via Prisma driver adapter `pg`)
DATABASE_URL="postgresql://user:password@localhost:5432/indokerja?schema=public"

# Access token (JWT)
JWT_SECRET="change-me-at-least-32-chars"
JWT_EXPIRES_IN="15m"

# Refresh token (JWT, rotating)
JWT_REFRESH_SECRET="change-me-different-at-least-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend origin allowed by CORS (production = deployed frontend URL)
FRONTEND_URL="http://localhost:5173"

# Optional; platform deploy overrides it automatically
# PORT=3000